APP_NAME="Music Exams Help"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="musicexams@musicexams.help"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Lead magnet PDF gating — see docs/dev-rules.md "Lead magnet PDF gating".
# When AWS_* keys are populated, LeadMagnetDelivery uses a presigned URL
# pointing at this path within AWS_BUCKET. When the keys aren't set,
# falls back to LEAD_MAGNET_PDF_URL (public URL).
LEAD_MAGNET_PDF_PATH="musicexamshelp/Trinity Exam Checklist.pdf"
LEAD_MAGNET_PDF_URL=

# HubSpot auto-sync of consented subscribers. Leave HUBSPOT_API_TOKEN blank on
# staging/local (like the Mailchimp keys) — the sync job no-ops when it's empty.
# HUBSPOT_CONSENT_PROPERTY is the internal name of a boolean HubSpot contact
# property (create it in HubSpot first) that mirrors marketing consent.
HUBSPOT_API_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_CONSENT_PROPERTY=

VITE_APP_NAME="${APP_NAME}"
